# Copy to apps/api/.env (gitignored). Never commit the real key.
OPENROUTER_API_KEY=
# A free model that supports tools. Run `npm run probe:api` to list current candidates.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PORT=8787
# Bind address. Loopback keeps the key private to this machine. Any other HOST refuses to start unless NOVA_DEV_TOKEN is set.
HOST=127.0.0.1
# Exact origins, or a prefix ending in * (dev only). The side panel's origin is chrome-extension://<id>.
CORS_ORIGINS=chrome-extension://*,http://localhost:5174
# Optional shared bearer token for local use. Leave empty to disable.
NOVA_DEV_TOKEN=
MAX_TOKENS=700
MAX_ROUNDS=4
REQUEST_TIMEOUT_MS=60000
# How long a turn waits for the panel to answer a lookup only it can make (reading a file).
CLIENT_TOOL_TIMEOUT_MS=30000
# Tokens per UTC day across every request to this server.
DAILY_TOKEN_CAP=200000
# 1 logs question text and tool inputs. Off by default: logs carry counts only.
LOG_PROMPTS=0

# --- Hosted mode (optional). Leave AUTH_MODE unset to run this server for yourself, as above. ---
# google: students sign in with Google, use is counted per student, and HOST may be a public address.
AUTH_MODE=none
# The OAuth client id the extension signs in with (Google Cloud console, "Web application" client).
GOOGLE_CLIENT_ID=
# Signs this server's access tokens. At least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Postgres for accounts, sessions, per-student use, and saved conversations. The schema is created on start.
DATABASE_URL=
# Only these email domains may sign in, comma separated. Empty allows any Google account.
ALLOWED_EMAIL_DOMAINS=
# Tokens one student may use per UTC day, and questions per ten minutes. 0 means no limit.
USER_DAILY_TOKEN_CAP=40000
USER_TURNS_PER_10_MIN=20
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 1 refuses every question at once (the kill switch). The panel then answers what it can on the device.
ASK_DISABLED=0
